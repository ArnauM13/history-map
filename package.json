{
  "name": "history-map",
  "private": true,
  "version": "0.1.0",
  "description": "Mapa històric d'Europa: les fronteres, les banderes i els fets dels segles XX i XXI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "data:borders": "node scripts/build-borders.mjs",
    "data:flags": "node scripts/fetch-flags.mjs",
    "data:sources": "node scripts/check-sources.mjs",
    "data:occupations": "node scripts/build-occupations.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.47.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "mapshaper": "^0.7.72",
    "oxlint": "^1.86.0",
    "polygon-clipping": "^0.15.7",
    "polylabel": "^2.1.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
